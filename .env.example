# docker compose 使用的本地配置模板。
# 复制为 .env 后填入本地开发用的值；.env 已在 .gitignore 中忽略，不会被提交。
# 这里只放本地一次性环境的占位值，不要填写任何真实环境的凭证。

# 本地 MySQL 容器的 root 口令，同时用于三个业务服务的数据库连接
HOW_COMPOSE_MYSQL_ROOT_PASSWORD=change-me-local-dev-only

# 本地 Redis 容器的口令
HOW_COMPOSE_REDIS_PASSWORD=change-me-local-dev-only

# 三个服务共用的 JWT 签名密钥，必须至少 32 字节
HOW_AUTH_JWT_SECRET=change-me-at-least-32-characters-long

# 跨域来源，逗号分隔；本地开发保持允许所有来源
HOW_CORS_ALLOWED_ORIGINS=*

# 宿主机映射端口，与服务端口一致即可；端口被占用时改这里
HOW_BASE_PUBLISHED_PORT=9001
HOW_ARTICLE_PUBLISHED_PORT=9004
HOW_USER_PUBLISHED_PORT=9008